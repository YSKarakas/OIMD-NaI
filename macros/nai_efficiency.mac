# G1 -- full-energy peak efficiency of a 3" x 3" NaI(Tl) crystal at 662 keV.
#
# Pure gamma transport: scintillation photons are generated but not stacked, so
# nothing here depends on the provisional optical parameters in the material
# file. This is the gate with no free parameters at all.

/scint/crystal/shape cylinder
/scint/crystal/diameter 76.2 mm
/scint/crystal/length 76.2 mm
/scint/crystal/materialSpec materials/NaI_Tl.dat

/scint/surface/treatment polished
/scint/surface/wrapping teflon
/scint/surface/coupling air
/scint/surface/model lut

/scint/coupling/type grease
/scint/coupling/thickness 0.1 mm

/scint/source/energy 662 keV
/scint/source/offsetZ -200 mm

/scint/output/file runs_scratch/nai_efficiency
/scint/output/format csv

/run/initialize

# Generate scintillation but do not track the photons: this measurement is about
# gamma transport only, and tracking 4e8 optical photons would serve no purpose.
/process/optical/scintillation/setStackPhotons false

/run/printProgress 20000
/run/beamOn 100000
