# Run outputs — reproducible from configs, never committed
runs/
# Generated static site
site/
# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
# C++ / CMake
build/
# Derived data caches (regenerable)
data/derived/
# macOS
.DS_Store
runs_scratch/
build/

# Literature corpus: PDFs are copyrighted, and the extracted text is a
# derivative of them. Both are rebuildable from scripts/collect_literature.py,
# so only the metadata index and the hand-extracted records are committed.
data/literature/cache/pdf/
data/literature/cache/txt/

# LaTeX intermediates. The PDF and the .docx ARE committed -- they are what
# gets read and emailed, and tests/test_paper.py fails if the PDF is older
# than the source -- but nothing below is worth a diff.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.spl
paper/*.toc
paper/*.synctex.gz
paper/build.log

# Elsevier's Guide for Authors, kept locally while preparing the submission.
# Third-party copyrighted material: it must not travel with a repository that
# is going to be published and archived under a DOI.
Guide for authors*.pdf

# Evidence the manuscript quotes: kept under version control despite the
# directory rules above, so the paper resolves from a clean clone.
!runs_scratch/
runs_scratch/*
!runs_scratch/gates_final.json
!runs_scratch/gates_final.txt
!runs_scratch/gates_schema4_cascade.json
!runs_scratch/gates_schema4_cascade.txt
!runs_scratch/equiv_host_nt_events.csv
!runs_scratch/equiv_container_nt_events.csv
!runs_scratch/equiv_host_repeat_nt_events.csv
!runs_scratch/equiv_container_repeat_nt_events.csv
!runs_scratch/diag/
!data/derived/
data/derived/*
!data/derived/atomic_data.csv
paper/sources/
